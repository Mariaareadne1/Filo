    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.122.0",
    "typescript": "~5.9.2"
