{
  "name": "filo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:db": "bash scripts/db-test.sh",
    "start:local": "eval $(node scripts/local-stack/keys.mjs) && EXPO_PUBLIC_SUPABASE_URL_OVERRIDE=http://127.0.0.1:55321 EXPO_PUBLIC_SUPABASE_ANON_KEY_OVERRIDE=$ANON expo start --port 8081",
    "stack:up": "eval $(node scripts/local-stack/keys.mjs) && bash scripts/local-stack/up.sh $ANON $SERVICE"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rnmapbox/maps": "^10.3.0",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "^5.104.5",
    "@types/aes-js": "^3.1.4",
    "aes-js": "^3.1.2",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
