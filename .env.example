# ── Filo environment ────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Supabase (public — safe to ship in the bundle; protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Mapbox public token (pk.) — used at runtime to render maps
EXPO_PUBLIC_MAPBOX_TOKEN=pk.<mapbox-public-token>

# Google Places (public in the bundle) — MUST be restricted in Google Cloud
# Console to the app's iOS bundle id / Android package + SHA-1 and the
# Places API only, or an extracted key enables billing abuse.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=<google-places-key>

# ── Build-time / server secrets (NOT exposed to the bundle) ──────────
# Mapbox DOWNLOAD token (sk.) — needed only during native prebuild/EAS build
# to fetch the SDK. In CI, store as an EAS secret of the same name.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.<mapbox-download-secret>

# Supabase service-role key — server/seed scripts only. NEVER ship to a client.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
